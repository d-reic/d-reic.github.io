---
// A small line-drawn ornament that hangs from the header ruler and changes with
// the calendar. On an international day (World Bee Day, Pi Day, …) it shows
// that day's drawing and links to it; otherwise Christmas, Easter, Halloween,
// or the season. Picked in the browser by date, so it switches on the right day
// without a rebuild. Preview any of them with ?season=bee, ?season=christmas, …
---
<div class="ornament-anchor wrap">
  <a class="ornament" hidden aria-hidden="true" tabindex="-1">
    <span class="thread"></span>
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></svg>
  </a>
</div>

<script is:inline>
  (() => {
    const el = document.querySelector(".ornament");
    if (!el) return;

    // Each drawing fits a 32×32 box hanging from its top centre (16, 0).
    const art = {
      christmas: { title: "Merry Christmas", d: '<rect x="13" y="2" width="6" height="4" rx="1"/><circle cx="16" cy="17" r="11" class="fill"/><path d="M6 15c6 3 14 3 20 0"/><path d="M8 21c5 2 11 2 16 0" stroke-dasharray="1 3"/>' },
      easter: { title: "Happy Easter", d: '<path d="M16 2C9.5 2 5 13 5 19.5 5 26 10 30 16 30s11-4 11-10.5C27 13 22.5 2 16 2Z" class="fill"/><path d="M5.6 15.5l3.6 3 3.6-3 3.6 3 3.6-3 3.6 3 3.4-2.8"/><path d="M6.5 23h19" stroke-dasharray="1 3"/>' },
      halloween: { title: "Happy Halloween", d: '<path d="M16 8c0-3 1-5 3.5-6"/><ellipse cx="16" cy="19" rx="13" ry="11" class="fill"/><path d="M10.5 9.6c-3 4-3 14.8 0 18.8M21.5 9.6c3 4 3 14.8 0 18.8"/><path d="M11 17l2-2.5 2 2.5ZM17 17l2-2.5 2 2.5ZM11.5 22.5c3 2 6 2 9 0"/>' },
      spring: { title: "Hello, spring", d: '<path d="M16 19.5V31M16 27c2.5-.5 4.5-2.5 4.5-5.5-2.5 0-4.5 2-4.5 5.5Z"/><g class="fill"><circle cx="16" cy="4.5" r="4"/><circle cx="22.2" cy="9" r="4"/><circle cx="19.8" cy="16.3" r="4"/><circle cx="12.2" cy="16.3" r="4"/><circle cx="9.8" cy="9" r="4"/></g><circle cx="16" cy="10.5" r="2.6" fill="currentColor" fill-opacity=".15"/>' },
      summer: { title: "Summer!", d: '<circle cx="16" cy="16" r="7" class="fill"/><path d="M16 2v4M16 26v4M2 16h4M26 16h4M6 6l2.8 2.8M23.2 23.2 26 26M6 26l2.8-2.8M23.2 8.8 26 6"/>' },
      autumn: { title: "Autumn leaves", d: '<path d="M16 2c-6 5-10 10-10 16 0 6 4.5 10 10 10s10-4 10-10C26 12 22 7 16 2Z" class="fill"/><path d="M16 4v27M16 13l-5 4M16 13l5 4M16 20l-6 4M16 20l6 4"/>' },
      winter: { title: "Hello, winter", d: '<path d="M16 2v28M4 9l24 14M4 23 28 9"/><path d="M12.5 4 16 7.5 19.5 4M12.5 28 16 24.5 19.5 28M3.5 13.5l4.5-1.2L6.8 8M28.5 18.5 24 19.7l1.2 4.3M3.5 18.5l4.5 1.2-1.2 4.3M28.5 13.5 24 12.3 25.2 8"/>' },
    };

    // International days: one day each, with a link. They win over everything else.
    const m = (now) => (now.getMonth() + 1) * 100 + now.getDate();
    const on = (md) => (now) => m(now) === md;
    const days = {
      education: { on: on(124), title: "International Day of Education", href: "https://www.un.org/en/observances/education-day",
        d: '<path d="M16 0v5"/><path d="M2 11 16 5l14 6-14 6Z" class="fill"/><path d="M8 13.6V21c0 2 3.6 4 8 4s8-2 8-4v-7.4M28 12v8"/><circle cx="28" cy="21.5" r="1.3"/>' },
      science: { on: on(211), title: "International Day of Women and Girls in Science", href: "https://www.un.org/en/observances/women-and-girls-in-science-day",
        d: '<path d="M9.2 20h13.6l3.2 5.5c.8 1.5-.3 3-2 3H8c-1.7 0-2.8-1.5-2-3Z" class="fill"/><path d="M12 3h8M13.5 3v8.5L6 25.5c-.8 1.5.3 3 2 3h16c1.7 0 2.8-1.5 2-3l-7.5-14V3"/><circle cx="14" cy="24" r="1"/><circle cx="19" cy="25.5" r=".8"/>' },
      pi: { on: on(314), title: "Pi Day", href: "https://en.wikipedia.org/wiki/Pi_Day",
        d: '<path d="M16 0v6.5"/><path d="M4.5 10c1.5-2.5 3.5-3.5 6.5-3.5h16.5M12.5 6.5c0 8-1.8 15.5-5 22M21.5 6.5c-1 8.5-.8 16 1 19.5 1.2 2.2 3.8 2.2 5.2-.2"/>' },
      health: { on: on(407), title: "World Health Day", href: "https://www.who.int/campaigns/world-health-day",
        d: '<path d="M16 28C8 22 3 17 3 11.5 3 7.4 6 4.5 9.6 4.5c2.6 0 4.8 1.5 6.4 3.8 1.6-2.3 3.8-3.8 6.4-3.8C26 4.5 29 7.4 29 11.5 29 17 24 22 16 28Z" class="fill"/><path d="M6 15h5l2-4 3 8 2-4h8"/>' },
      book: { on: on(423), title: "World Book Day", href: "https://www.unesco.org/en/days/world-book-and-copyright",
        d: '<path d="M16 0v8"/><path d="M16 8C12 5 7 5 3 6.5v19C7 24 12 24 16 27c4-3 9-3 13-1.5v-19C25 5 20 5 16 8Z" class="fill"/><path d="M16 8v19M6.5 11c2.5-.6 4.5-.3 6.5.8M6.5 16c2.5-.6 4.5-.3 6.5.8M19 11.8c2-1.1 4-1.4 6.5-.8M19 16.8c2-1.1 4-1.4 6.5-.8"/>' },
      bee: { on: on(520), title: "World Bee Day", href: "https://www.un.org/en/observances/bee-day",
        d: '<path d="M16 0v3.3"/><circle cx="16" cy="6.5" r="3.2"/><path d="M14.5 3.6 12.8 1.2M17.5 3.6l1.7-2.4"/><ellipse cx="8.5" cy="12" rx="6" ry="3.6" transform="rotate(-20 8.5 12)"/><ellipse cx="23.5" cy="12" rx="6" ry="3.6" transform="rotate(20 23.5 12)"/><ellipse cx="16" cy="19.5" rx="6.2" ry="9" class="fill"/><path d="M10.2 16.5h11.6M10 21.5h12M11.6 26h8.8M16 28.5v3"/>' },
      cat: { on: on(808), title: "International Cat Day", href: "https://en.wikipedia.org/wiki/International_Cat_Day",
        d: '<path d="M16 0v9"/><path d="M6 12 5 3.5l7 5.2c2.6-.9 5.4-.9 8 0l7-5.2-1 8.5c1.5 2.2 2 4.5 2 7 0 6-6 10-12 10S4 25 4 19c0-2.5.5-4.8 2-7Z" class="fill"/><path d="M11.5 17.5v1.5M20.5 17.5v1.5M14.8 22h2.4L16 23.3ZM16 23.3c-.5 1.4-2 2-3 1.4M16 23.3c.5 1.4 2 2 3 1.4M2 20.5l7-.5M2.5 24l6.8-2M30 20.5l-7-.5M29.5 24l-6.8-2"/>' },
      swiss: { on: on(801), title: "Swiss National Day", href: "https://en.wikipedia.org/wiki/Swiss_National_Day",
        d: '<rect x="4" y="4" width="24" height="24" rx="2" class="fill"/><path d="M13.5 9h5v5h5v5h-5v5h-5v-5h-5v-5h5Z" class="white" stroke="none"/><path d="M16 0v4"/>' },
      austria: { on: on(1026), title: "Austrian National Day", href: "https://de.wikipedia.org/wiki/Nationalfeiertag_(%C3%96sterreich)",
        d: '<rect x="3" y="7" width="26" height="6" class="fill" stroke="none"/><rect x="3" y="13" width="26" height="6" class="white" stroke="none"/><rect x="3" y="19" width="26" height="6" class="fill" stroke="none"/><rect x="3" y="7" width="26" height="18" rx="1.5"/><path d="M16 0v7"/>' },
      programmers: { title: "Programmers' Day, the 256th day of the year", href: "https://en.wikipedia.org/wiki/Programmers%27_Day",
        on: (now) => Math.round((now - new Date(now.getFullYear(), 0, 0)) / 864e5) === 256,
        d: '<path d="M16 0v5"/><rect x="3" y="5" width="26" height="22" rx="3" class="fill"/><path d="M3 10h26M10 15l-3.5 3.5L10 22M22 15l3.5 3.5L22 22M17.5 14l-3 9"/>' },
      coffee: { on: on(1001), title: "International Coffee Day", href: "https://en.wikipedia.org/wiki/International_Coffee_Day",
        d: '<path d="M16 0v4"/><path d="M12.5 4c-1.5 1.8 1.5 3.2 0 5M16 4c-1.5 1.8 1.5 3.2 0 5M19.5 4c-1.5 1.8 1.5 3.2 0 5"/><path d="M5 12h19v8c0 5-4.2 8.5-9.5 8.5S5 25 5 20Z" class="fill"/><path d="M24 14.5h1.5c2.2 0 3.5 1.4 3.5 3.3s-1.3 3.4-3.5 3.4H23.4M3 30h23"/>' },
      teachers: { on: on(1005), title: "World Teachers' Day", href: "https://www.unesco.org/en/days/teachers",
        d: '<path d="M16 9c-2-1.5-4.5-2-7-1-4 1.5-5.5 6-4.5 10.5C5.8 25 10 30 13.5 29.5c1-.1 1.7-.6 2.5-.6s1.5.5 2.5.6C22 30 26.2 25 27.5 18.5c1-4.5-.5-9-4.5-10.5-2.5-1-5-.5-7 1Z" class="fill"/><path d="M16 9c0-3 1-5.5 3-7M16.5 6.5c2-2.2 5-2.6 7-1.6-1.2 2.4-4.3 3-7 1.6Z"/>' },
      mentalhealth: { on: on(1010), title: "World Mental Health Day", href: "https://www.who.int/campaigns/world-mental-health-day",
        d: '<path d="M11.5 30 19.6 13c2-4.4.2-9.5-3.6-9.5S10.4 8.6 12.4 13L20.5 30" stroke-width="2.4"/>' },
      ada: { title: "Ada Lovelace Day", href: "https://en.wikipedia.org/wiki/Ada_Lovelace_Day",
        on: (now) => now.getMonth() === 9 && now.getDay() === 2 && now.getDate() >= 8 && now.getDate() <= 14,
        d: '<path d="M16 0v7"/><path d="M3 7h21l5 5v14H3Z" class="fill"/><path d="M7 11v2M7 18v2M11 14v2M11 21v2M15 11v2M15 16v2M19 13v2M19 20v2M23 16v2M23 21v2M26 18v2"/>' },
      radiology: { on: on(1108), title: "International Day of Radiology", href: "https://en.wikipedia.org/wiki/International_Day_of_Radiology",
        d: '<rect x="4" y="3" width="24" height="27" rx="2" class="fill"/><path d="M16 7v19M15 10c-3-1-6 0-7 2M15 13.5c-3-1-6.5 0-7.5 2M15 17c-3-1-6.5 0-7.5 2M15 20.5c-3-1-6 0-7 2M17 10c3-1 6 0 7 2M17 13.5c3-1 6.5 0 7.5 2M17 17c3-1 6.5 0 7.5 2M17 20.5c3-1 6 0 7 2"/>' },
    };

    // Easter Sunday (Anonymous Gregorian algorithm).
    const easter = (y) => {
      const a = y % 19, b = Math.floor(y / 100), c = y % 100, d = Math.floor(b / 4), e = b % 4;
      const f = Math.floor((b + 8) / 25), g = Math.floor((b - f + 1) / 3);
      const h = (19 * a + b - d - g + 15) % 30, i = Math.floor(c / 4), k = c % 4;
      const l = (32 + 2 * e + 2 * i - h - k) % 7, m = Math.floor((a + 11 * h + 22 * l) / 451);
      const month = Math.floor((h + l - 7 * m + 114) / 31), day = ((h + l - 7 * m + 114) % 31) + 1;
      return new Date(y, month - 1, day);
    };

    const season = (now) => {
      const y = now.getFullYear(), md = (now.getMonth() + 1) * 100 + now.getDate();
      const e = easter(y), day = 864e5;
      if (now >= new Date(e - 14 * day) && now < new Date(+e + 2 * day)) return "easter";
      if (md >= 1201 && md <= 1226) return "christmas";
      if (md === 1031) return "halloween";
      if (md >= 320 && md <= 620) return "spring";
      if (md >= 621 && md <= 922) return "summer";
      if (md >= 923 && md <= 1130) return "autumn";
      return "winter";
    };

    const today = new Date();
    const forced = new URLSearchParams(location.search).get("season");
    const key = forced in days || forced in art ? forced
      : Object.keys(days).find((k) => days[k].on(today)) ?? season(today);
    const { title, d, href } = days[key] ?? art[key];
    el.querySelector("svg").innerHTML = d;
    el.dataset.season = key;
    el.hidden = false;
    if (href) {
      // A special day: the ornament becomes a link to it.
      el.href = href;
      el.target = "_blank";
      el.rel = "noopener";
      el.title = `Today is ${title} ↗`;
      el.setAttribute("aria-label", `Today is ${title} (opens in a new tab)`);
      el.removeAttribute("aria-hidden");
      el.removeAttribute("tabindex");
    } else {
      el.title = title;
    }
  })();
</script>
