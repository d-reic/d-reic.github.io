---
// Fonts are bundled with the site (no requests to Google): latin subsets only.
import "@fontsource/instrument-serif/latin-400.css";
import "@fontsource/instrument-serif/latin-400-italic.css";
import "@fontsource/geist/latin-400.css";
import "@fontsource/geist/latin-500.css";
import "@fontsource/geist/latin-600.css";
import "@fontsource/geist-mono/latin-400.css";
import "@fontsource/geist-mono/latin-500.css";
import "../styles/global.css";
import { site } from "../site.config";
import ThemeToggle from "../components/ThemeToggle.astro";
import SeasonalOrnament from "../components/SeasonalOrnament.astro";

interface Props {
  title?: string;
  description?: string;
  progress?: boolean;
  image?: string;
  /** Keep the page out of search results (404, an empty blog). */
  noindex?: boolean;
  /** schema.org structured data for this page. */
  jsonLd?: object | object[];
}
const { title, description = site.description, progress = false, image, noindex = false, jsonLd } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.seoTitle;
const path = Astro.url.pathname;
const isHome = path === "/";
const canonical = new URL(path, Astro.site);
---
<!doctype html>
<html lang="en" data-theme="system">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={site.name} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f5f2ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131417" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={progress ? "article" : "website"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={new URL(image ?? "/og/default.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        document.documentElement.dataset.theme = t === "light" || t === "dark" ? t : "system";
      } catch (_) {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <div class="bar">
          {isHome ? (
            <h1 class="brand-h1"><a class="brand" href="/">{site.name}<em>: {site.tagline}</em></a></h1>
          ) : (
            <a class="brand" href="/">{site.name}<em>: {site.tagline}</em></a>
          )}
          <nav class="nav" aria-label="Main">
            {site.nav.map((n) => (
              <a href={n.href} aria-current={path.startsWith(n.href) ? "page" : undefined}>{n.label}</a>
            ))}
            <ThemeToggle />
          </nav>
        </div>
        <div class="ruler" aria-hidden="true">{progress && <div class="progress"></div>}</div>
      </div>
    </header>

    <SeasonalOrnament />

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer wrap">
      <div class="ruler" aria-hidden="true"></div>
      {site.aiDeclaration && <p class="ai-declaration" set:html={site.aiDeclaration} />}
      <div class="row">
        <span class="mono">© {new Date().getFullYear()} {site.name} <span class="egg-hint" title="Psst, try typing this on the page">· ↑↑↓↓←→←→BA</span></span>
        <div class="links">
          {site.links.map((l) => <a href={l.href}>{l.label}</a>)}
        </div>
      </div>
    </footer>

    {progress && (
      <script is:inline>
        (() => {
          const root = document.documentElement;
          const bar = document.querySelector(".site-header .ruler");
          const article = document.querySelector("article");
          const update = () => {
            const r = article.getBoundingClientRect();
            const p = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - innerHeight)));
            bar.style.setProperty("--progress", p.toFixed(4));
          };
          addEventListener("scroll", update, { passive: true });
          addEventListener("resize", update);
          update();
        })();
      </script>
    )}
    <script>
      import "../scripts/hairline";
      import "../scripts/confetti";
    </script>
    {site.goatcounter && (
      <script is:inline async data-goatcounter={`https://${site.goatcounter}.goatcounter.com/count`} src="https://gc.zgo.at/count.js"></script>
    )}
  </body>
</html>
