---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import HairlineFigure from "../../components/HairlineFigure.astro";
import { getPosts, fmtDate, readingTime, type Post } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const d = post.data;
---
<Base title={d.title} description={d.description} image={d.cover} progress>
  <article>
    <header class="post-head measure">
      <div class="post-meta">
        <span class="mono">{fmtDate(d.date)}</span>
        <span class="mono">·</span>
        <span class="mono">{readingTime(post.body)}</span>
        {d.updated && <span class="mono">· updated {fmtDate(d.updated)}</span>}
        {d.draft && <span class="chip">draft</span>}
      </div>
      <h1>{d.title}</h1>
      <p class="lede">{d.description}</p>
      <div class="chips">{d.tags.map((t) => <a class="chip" href={`/tags/${t}/`}>{t}</a>)}</div>
    </header>

    {d.cover ? (
      <figure class="fig post-art">
        <div class="fig-plate cover"><img src={d.cover} alt={d.coverCaption ?? ""} /></div>
        <figcaption><b>Fig. 0</b><span>{d.coverCaption ?? "AI-generated illustration"}</span></figcaption>
      </figure>
    ) : d.figure ? (
      <HairlineFigure name={d.figure} n={0} play class="post-art" plateClass="figure" />
    ) : null}

    <div class="prose measure">
      <Content />
    </div>
  </article>

  <nav class="post-foot measure" aria-label="More posts">
    {older && <a href={`/blog/${older.id}/`}><span class="mono">← Older</span><span class="t">{older.data.title}</span></a>}
    {newer && <a class="next" href={`/blog/${newer.id}/`}><span class="mono">Newer →</span><span class="t">{newer.data.title}</span></a>}
  </nav>
</Base>
