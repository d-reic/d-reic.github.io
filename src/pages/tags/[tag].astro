---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { getPosts, tagCounts } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return tagCounts(posts).map(([tag]) => ({ params: { tag }, props: { tag } }));
}
const { tag } = Astro.props;
const posts = await getPosts();
const tagged = posts.filter((p) => p.data.tags.includes(tag));
const tags = tagCounts(posts);
---
<Base title={`#${tag}`} description={`Posts tagged ${tag}.`}>
  <section class="page-head" style="grid-template-columns: 1fr">
    <div>
      <div class="eyebrow"><a href="/blog/">Blog</a> / tag</div>
      <h1>{tag}</h1>
      <div class="chips">{tags.map(([t, c]) => <a class="chip" href={`/tags/${t}/`} aria-current={t === tag ? "page" : undefined}>{t}<small>{c}</small></a>)}</div>
    </div>
  </section>
  <section style="margin-top: 40px"><PostList posts={tagged} /></section>
</Base>
