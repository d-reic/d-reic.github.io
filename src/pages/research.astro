---
import Base from "../layouts/Base.astro";
import HairlineFigure from "../components/HairlineFigure.astro";
import CitationsChart from "../components/CitationsChart.astro";
import research from "../data/research.json";
import { site } from "../site.config";
import { publicationList } from "../lib/schema";

const scholar = site.links.find((l) => l.label === "Scholar")?.href;

const types: Record<string, string> = {
  "journal-article": "Journal article",
  "conference-paper": "Conference paper",
  "book-chapter": "Book chapter",
  preprint: "Preprint",
  "data-set": "Dataset",
};
const years = [...new Set(research.works.map((w) => w.year))];
const selected = site.selectedPublications
  .map((doi) => research.works.find((w) => w.doi === doi.toLowerCase()))
  .filter((w) => w !== undefined);
---
<Base title="Research & Publications" description="Publications and citations of Daniel Reichenpfader on clinical NLP, LLMs for radiology reports, information extraction and digital health, updated daily." jsonLd={publicationList(research.works)}>
  <section class="page-head">
    <div class="reveal">
      <div class="eyebrow">Clinical NLP · LLMs in medicine · digital health</div>
      <h1>Research</h1>
      <p>Natural language processing for radiology and clinical text, large language models in medicine, and digital health applications. The list below comes straight from my <a href={`https://orcid.org/${research.orcid}`}>ORCID</a> record; citation counts are from OpenAlex, so they run lower than on my <a href={scholar}>Google Scholar</a> profile.</p>
    </div>
    <HairlineFigure
      name="lightbox"
      n={1}
      play
      class="reveal reveal-2"
      label="A lightbox with three x-rays; the film under the pointer swings out to be read"
    />
  </section>

  {selected.length > 0 && (
    <section>
      <div class="section-title"><h2>Selected</h2><span class="line"></span></div>
      <div class="cards selected">
        {selected.map((w) => (
          <a class="card" href={w.url}>
            <span class="eyebrow">{[w.venue, w.year].filter(Boolean).join(" · ")}</span>
            <h3>{w.title}</h3>
            {w.citations != null && <span class="mono">{w.citations} citations</span>}
          </a>
        ))}
      </div>
    </section>
  )}

  <section>
    <div class="section-title"><h2>Citations</h2><span class="line"></span></div>
    <div class="research-strip">
      <dl class="stats">
        <div><dt>Citations</dt><dd>{research.totals.citations}</dd></div>
        <div><dt>h-index</dt><dd>{research.totals.hIndex}</dd></div>
        <div><dt>Publications</dt><dd>{research.totals.publications}</dd></div>
      </dl>
      <CitationsChart />
    </div>
  </section>

  {site.talks.length > 0 && (
    <section>
      <div class="section-title"><h2>Talks &amp; invited lectures</h2><span class="line"></span></div>
      <ol class="timeline">
        {site.talks.map((t) => (
          <li>
            <span class="mono">{t.when}</span>
            <div>
              <div class="w">{t.href ? <a href={t.href}>{t.title}</a> : t.title}</div>
              <div class="note">{[t.kind, t.event].join(" · ")}</div>
              {t.note && <div class="note">{t.note}</div>}
            </div>
          </li>
        ))}
      </ol>
    </section>
  )}

  <section>
    <div class="section-title"><h2>Publications</h2><span class="line"></span></div>
    {years.map((y) => (
      <>
        <h3 class="year">{y ?? "Undated"}</h3>
        <ol class="pubs">
          {research.works.filter((w) => w.year === y).map((w) => (
            <li>
              <div>
                {w.url ? <a class="t" href={w.url}>{w.title}</a> : <span class="t">{w.title}</span>}
                <div class="meta">{[types[w.type] ?? w.type, w.venue].filter(Boolean).join(" · ")}</div>
              </div>
              <div class="n">{w.citations != null && <><b>{w.citations}</b>{w.citations === 1 ? "citation" : "citations"}</>}</div>
            </li>
          ))}
        </ol>
      </>
    ))}
  </section>
</Base>
