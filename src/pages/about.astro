---
import Base from "../layouts/Base.astro";
import Portrait from "../components/Portrait.astro";
import HairlineFigure from "../components/HairlineFigure.astro";
import { site } from "../site.config";
---
<Base title="About">
  <div class="about-grid">
    <aside class="about-side">
      <Portrait n={1} />
      <dl>
        <dt>Currently</dt><dd>{site.role}</dd>
        <dt>Based in</dt><dd>{site.location}</dd>
        <dt>Interests</dt><dd>{site.interests.join(", ")}</dd>
        <dt>Elsewhere</dt><dd>{site.links.map((l, i) => <>{i > 0 && " · "}<a href={l.href}>{l.label}</a></>)}</dd>
      </dl>
    </aside>

    <div class="about-main">
      <h1>About</h1>
      <div class="intro">{site.bio.map((p) => <p set:html={p} />)}</div>

      <div class="section-title" style="margin-top: 56px"><h2>Path so far</h2><span class="line"></span></div>
      <ol class="timeline">
        {site.timeline.map((t) => (
          <li>
            <span class="mono">{t.when}</span>
            <div>
              <div class="w">{t.what} <span class="where">· {t.where}</span></div>
              {t.note && <div class="note">{t.note}</div>}
            </div>
          </li>
        ))}
      </ol>

      <HairlineFigure name="branches" n={2} caption="The usual path, roughly." play class="" plateClass="" />
    </div>
  </div>
</Base>
