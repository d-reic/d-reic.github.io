---
import Base from "../layouts/Base.astro";
import Portrait from "../components/Portrait.astro";
import { site } from "../site.config";
import { profilePage } from "../lib/schema";
---
<Base title="About" description="About Daniel Reichenpfader: experience and education, from medical informatics in Graz to clinical NLP research and teaching at BFH in Biel." jsonLd={profilePage}>
  <div class="about-grid">
    <aside class="about-side">
      <Portrait n={1} />
      <dl>
        <dt>Currently</dt><dd>{site.role}</dd>
        <dt>Based in</dt><dd>{site.location}</dd>
        <dt>Interests</dt><dd>{site.interests.join(", ")}</dd>
        <dt>Elsewhere</dt><dd class="elsewhere">{site.links.map((l) => <a href={l.href}>{l.label}</a>)}</dd>
      </dl>
    </aside>

    <div class="about-main">
      <h1>About</h1>
      <div class="intro">{site.aboutBio.map((p) => <p set:html={p} />)}</div>

      {[
        { title: "Experience", items: site.experience },
        { title: "Education", items: site.education },
      ].map((section) => (
        <>
          <div class="section-title" style="margin-top: 56px"><h2>{section.title}</h2><span class="line"></span></div>
          <ol class="timeline">
            {section.items.map((t) => (
              <li>
                <span class="mono">{t.when}</span>
                <div>
                  <div class="w">{t.what} <span class="where">{t.where}</span></div>
                  {t.note && <div class="note">{t.note}</div>}
                </div>
              </li>
            ))}
          </ol>
        </>
      ))}

      <div class="section-title" style="margin-top: 56px"><h2>Toolbox</h2><span class="line"></span></div>
      <div class="chips" style="margin-bottom: 48px">{site.skills.map((s) => <span class="chip">{s}</span>)}</div>

    </div>
  </div>
</Base>
