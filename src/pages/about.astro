---
import Base from "../layouts/Base.astro";
import Portrait from "../components/Portrait.astro";
import HairlineFigure from "../components/HairlineFigure.astro";
import { site } from "../site.config";
---
<Base title="About">
  <div class="about-grid">
    <aside class="about-side">
      <Portrait n={1} />
      <dl>
        <dt>Currently</dt><dd>{site.role}</dd>
        <dt>Based in</dt><dd>{site.location}</dd>
        <dt>Interests</dt><dd>{site.interests.join(", ")}</dd>
        <dt>Elsewhere</dt><dd>{site.links.map((l, i) => <>{i > 0 && " · "}<a href={l.href}>{l.label}</a></>)}</dd>
      </dl>
    </aside>

    <div class="about-main">
      <h1>About</h1>
      <div class="intro">{site.bio.map((p) => <p set:html={p} />)}</div>

      {[
        { title: "Experience", items: site.experience },
        { title: "Education", items: site.education },
      ].map((section) => (
        <>
          <div class="section-title" style="margin-top: 56px"><h2>{section.title}</h2><span class="line"></span></div>
          <ol class="timeline">
            {section.items.map((t) => (
              <li>
                <span class="mono">{t.when}</span>
                <div>
                  <div class="w">{t.what} <span class="where">· {t.where}</span></div>
                  {t.note && <div class="note">{t.note}</div>}
                </div>
              </li>
            ))}
          </ol>
        </>
      ))}

      <div class="section-title" style="margin-top: 56px"><h2>Projects</h2><span class="line"></span></div>
      <ul class="timeline">
        {site.projects.map((p) => (
          <li>
            <span class="mono">{p.links.map((l, i) => <>{i > 0 && " · "}<a href={l.href}>{l.label}</a></>)}</span>
            <div>
              <div class="w">{p.name}</div>
              <div class="note">{p.note}</div>
            </div>
          </li>
        ))}
      </ul>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 24px; margin-top: 28px">
        <HairlineFigure name="barbell" n={2} caption="AMRAP, loaded." play label="A loaded barbell; the pointer's height sets the load and plates slide on and off" />
        <HairlineFigure name="harp" n={3} caption="Der Harfenist." play label="A concert harp; the strings under the pointer are plucked and ring" />
      </div>

      <div class="section-title" style="margin-top: 56px"><h2>Toolbox</h2><span class="line"></span></div>
      <div class="chips" style="margin-bottom: 48px">{site.skills.map((s) => <span class="chip">{s}</span>)}</div>

    </div>
  </div>
</Base>
