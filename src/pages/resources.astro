---
import Base from "../layouts/Base.astro";
import HairlineFigure from "../components/HairlineFigure.astro";

// Prompts and AI tools worth trying.
// Only links and own short descriptions; the prompt texts stay with their authors.
type Item = { title: string; text: string; href: string; source: string; level: "Beginner" | "Intermediate" | "Advanced" };

const prompts: Item[] = [
  {
    title: "Pyramid Principle: four prompts for emails",
    text: "Answer first, an opening built on SCQA, a MECE check of the arguments and an \"executive test\" before you hit send.",
    href: "https://x.com/heynavtoor/status/2080238307813040398",
    source: "Nav Toor on X",
    level: "Beginner",
  },
  {
    title: "The \"brutally honest advisor\"",
    text: "A role prompt against too much agreement. Does it give better criticism, or just a harsher tone?",
    href: "https://www.instagram.com/p/DdZFTOTAIhj/",
    source: "Evolving AI on Instagram",
    level: "Beginner",
  },
  {
    title: "Greg Brockman's prompt formula",
    text: "Four building blocks for tasks given to AI agents. Worth asking: what is new compared with a good brief, and is the attribution right?",
    href: "https://www.instagram.com/p/Dd6xT5QCRQd/",
    source: "artificialintelligence.co on Instagram",
    level: "Intermediate",
  },
  {
    title: "Seven symbols for a brief",
    text: "Mark headings, rules and gaps with simple characters. Useful to compare with your own way of writing a brief.",
    href: "https://www.instagram.com/p/Deb223KFbZo/",
    source: "Quentin on Instagram",
    level: "Intermediate",
  },
  {
    title: "Presentations after Patrick Winston",
    text: "Prompts that apply the MIT professor's approach to presenting to your own slides.",
    href: "https://www.instagram.com/p/DWv7OK1khYq/",
    source: "God of Prompt on Instagram",
    level: "Intermediate",
  },
  {
    title: "Heilmeier Extractor",
    text: "A prompt that summarises research papers along DARPA's Heilmeier Catechism, with pointers to the sections and a check for hidden instructions. The prompt is in the comments.",
    href: "https://www.linkedin.com/posts/prof-todd-austin_ai-aitools-research-share-7405033853662343168-MZPH/",
    source: "Todd Austin on LinkedIn",
    level: "Intermediate",
  },
];

const tools: Item[] = [
  {
    title: "NotebookLM and other Google AI tools",
    text: "An overview of Google's AI tools. Worth a try: NotebookLM for getting into a new topic, with a briefing document and a quiz.",
    href: "https://www.instagram.com/p/DdoSzpEkkfv/",
    source: "Ankit Dungawat on Instagram",
    level: "Beginner",
  },
  {
    title: "NotebookLM prompts for preparation",
    text: "Three prompts that chain research, a briefing document and a quiz in NotebookLM. They carry over well to onboarding new staff.",
    href: "https://www.instagram.com/reels/DdwohTTIcZj/",
    source: "Frank Andrade on Instagram",
    level: "Beginner",
  },
  {
    title: "Claude Setup Kit",
    text: "Settings, prompts and the newer formats of the Claude app, including docs, slides, designs, dashboards and motion.",
    href: "https://www.futurepedia.io/resources/claude-setup-kit/view",
    source: "Futurepedia",
    level: "Beginner",
  },
  {
    title: "Claude Whiteboards",
    text: "Plans and retros on a shared whiteboard that Claude organises and turns into a document or a presentation.",
    href: "https://www.instagram.com/p/Dfm9AZfDO9G/",
    source: "bestapps.ai on Instagram",
    level: "Beginner",
  },
  {
    title: "Understanding learning with AI",
    text: "Workshop material from the BFH Virtual Academy on the difference between performance and learning, and on AI as a tutor.",
    href: "https://virtuelleakademie.github.io/lernen-mit-ki-verstehen/",
    source: "BFH Virtual Academy",
    level: "Intermediate",
  },
  {
    title: "La Forge du Tuteur IA",
    text: "A tool from the University of Lausanne for building your own AI tutors.",
    href: "https://ia.unil.ch/forge-tuteur/",
    source: "University of Lausanne",
    level: "Intermediate",
  },
  {
    title: "SkillSpector",
    text: "A security scanner for agent skills. The README summarises a study that found vulnerabilities in about a quarter of the skills examined. A good checklist before you install someone else's skills.",
    href: "https://github.com/nvidia/skillspector",
    source: "NVIDIA on GitHub",
    level: "Advanced",
  },
  {
    title: "LLM Wiki",
    text: "An idea file: a language model builds a growing, linked wiki from your sources instead of searching again for every question.",
    href: "https://gist.github.com/karpathy/442a6bf555914893e9891c11519de94f",
    source: "Andrej Karpathy on GitHub",
    level: "Advanced",
  },
];

const groups = [
  { title: "Prompts", items: prompts },
  { title: "Tools and resources", items: tools },
];
---
<Base
  title="Prompts and AI tools"
  description="A selection of prompts and AI tools worth trying."
  noindex
>
  <section class="page-head">
    <div class="reveal">
      <div class="eyebrow">Resources</div>
      <h1>Prompts and AI tools</h1>
      <p>A selection worth trying. Test them and judge for yourself: useful or hype? Many prompt formulas from social media are good briefing principles in new packaging, so check the source too.</p>
    </div>
    <HairlineFigure name="loupe" n={1} play class="reveal reveal-2" label="A stand loupe on a ruled sheet" />
  </section>

  {groups.map((g) => (
    <section>
      <div class="section-title"><h2>{g.title}</h2><span class="line"></span></div>
      <div class="cards">
        {g.items.map((it) => (
          <a class="card" href={it.href} rel="noopener">
            <h3>{it.title}</h3>
            <p>{it.text}</p>
            <span class="mono">{it.level} · {it.source}</span>
          </a>
        ))}
      </div>
    </section>
  ))}
</Base>
