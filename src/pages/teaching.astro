---
import Base from "../layouts/Base.astro";
import { site } from "../site.config";

const { teaching } = site;
---
<Base title="Teaching" description="Courses Daniel Reichenpfader teaches at Bern University of Applied Sciences (BFH) and the University of Bern: clinical apps, quality management in healthcare, studying with genAI and research internships.">
  <section class="page-head">
    <div class="reveal">
      <div class="eyebrow">Bern University of Applied Sciences and University of Bern</div>
      <h1>Teaching</h1>
      <p>I teach clinical apps, quality management and the practical use of generative AI, mostly in the BSc Medical Informatics in Biel. Current details are on my <a href={teaching.profile}>BFH profile</a>.</p>
    </div>
  </section>

  <section>
    <div class="section-title"><h2>Courses</h2><span class="line"></span></div>
    <ul class="timeline">
      {teaching.modules.map((m) => (
        <li>
          <span class="mono">{m.role}</span>
          <div>
            <div class="w">{m.name}</div>
            {m.subtitle && <div class="sub">{m.subtitle}</div>}
            {m.note && <div class="note">{m.note}</div>}
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <div class="section-title"><h2>Programmes</h2><span class="line"></span></div>
    <ul class="timeline single">
      {teaching.programmes.map((p) => (
        <li>
          <div>
            <div class="w">{p.href ? <a href={p.href}>{p.name}</a> : p.name}</div>
            <div class="note">{p.where}</div>
          </div>
        </li>
      ))}
    </ul>
  </section>
</Base>
